// Managers to upgrade JS HTTP imports in deno configuration files or deps.ts/js files
// Defines patterns for jsDelivr and esm.sh
{
	"gitIgnoredAuthors": ["github-actions[bot]"],
	"customManagers": [
		// Select jsdelivr and esm.sh versions from github releases in deno.json files
		{
			"customType": "jsonata",
			"fileFormat": "json",
			"managerFilePatterns": ["deno.json", "deno.jsonc"],
			"matchStrings": [
				"$each(imports,/:\\/\\/(cdn\\.jsdelivr\\.net)\\/gh\\/([^@]+)@([\\d.]+)/).{'depName':groups[1],'currentValue':groups[2]}"
			],
			"datasourceTemplate": "github-releases",
			"versioningTemplate": "semver"
		},
		// Also select jsdelivr and esm.sh versions with github releases in deps .ts/.js files
		{
			"customType": "regex",
			"managerFilePatterns": ["deps.ts", "deps.js"],
			"matchStrings": [
				":\\/\\/(cdn\\.jsdelivr\\.net)\\/gh\\/(?<depName>.*?)@(?<currentValue>[\\d\\.]+)"
			],
			"datasourceTemplate": "github-releases",
			"versioningTemplate": "semver"
		}
	]
}
